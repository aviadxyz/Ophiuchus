LLM_PROVIDER=ollama
EXTRACTION_MODE=relations_first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_SECONDS=300
EXTRACTION_CHUNK_SIZE=2400
EXTRACTION_CHUNK_OVERLAP=200
ENRICHMENT_CHUNK_SIZE=1600
RELATION_CHUNK_SIZE=1600
RELATION_NUM_PREDICT=1024
# 0 extracts all eligible chunks. Positive values select the highest-priority chunks per document.
HRR_MAX_CHUNKS_PER_DOCUMENT=3
# Optional cloud provider; used only when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
